{
  "info": {
    "_postman_id": "YOUR_UNIQUE_COLLECTION_ID",
    "name": "Course Enrollment System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API endpoints for the Course Enrollment System built with Next.js, Prisma, and PostgreSQL."
  },
  "item": [
    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "description": "Returns all courses with instructor name and number of enrolled students."
          },
          "response": []
        },
        {
          "name": "Get Course Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/{{courseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "{{courseId}}"
              ]
            },
            "description": "Returns full course details, including instructor and list of enrolled students.\n\n**IMPORTANT**: Replace `{{courseId}}` with an actual course ID (e.g., 1, 2)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "description": "Returns a list of all students. (Needed for the Enroll page dropdowns)."
          },
          "response": []
        },
        {
          "name": "Get Student Profile by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            },
            "description": "Returns student profile including a list of enrolled courses.\n\n**IMPORTANT**: Replace `{{studentId}}` with an actual student ID (e.g., 1, 2)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Enroll Student in Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"studentId\": 1,\n    \"courseId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enroll"
              ]
            },
            "description": "Enrolls a student in a course.\n\n**IMPORTANT**: Adjust `studentId` and `courseId` in the request body to valid existing IDs."
          },
          "response": []
        },
        {
          "name": "Unenroll Student from Course (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/enroll/{{enrollmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "enroll",
                "{{enrollmentId}}"
              ]
            },
            "description": "Unenrolls a student from a course.\n\n**IMPORTANT**: Replace `{{enrollmentId}}` with an actual enrollment ID from your database (e.g., 1, 2). This is the ID of the enrollment record itself, not the student or course ID."
          },
          "response": []
        }
      ]
    }
  ]
}
